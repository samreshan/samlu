{
  "_comment": "Single source of truth for the mascot overlay. Safe to edit by hand. No rebuild needed for value changes (the pet window reloads it on open).",

  "spritesheet": "assets/spritesheet.webp",
  "cell":  { "width": 192, "height": 208 },
  "sheet": { "cols": 8, "rows": 9 },
  "scale": 0.58,

  "states": {
    "idle":          { "row": 0, "frames": 6, "fps": 5,  "loop": true },
    "working":       { "row": 1, "frames": 8, "fps": 8,  "loop": true },
    "running_left":  { "row": 2, "frames": 8, "fps": 10, "loop": true },
    "waving":        { "row": 3, "frames": 4, "fps": 6,  "loop": false },
    "jumping":       { "row": 4, "frames": 5, "fps": 10, "loop": false },
    "failed":        { "row": 5, "frames": 8, "fps": 6,  "loop": false },
    "waiting":       { "row": 6, "frames": 6, "fps": 4,  "loop": true },
    "review":        { "row": 7, "frames": 6, "fps": 5,  "loop": true },
    "sitting":       { "row": 5, "col": 6, "frames": 2, "fps": 2, "loop": true, "scale": 0.75 },
    "running_right": { "row": 8, "frames": 6, "fps": 9,  "loop": true }
  },

  "events": {
    "hover":            "waving",
    "click":            "waving",
    "doubleClick":      "jumping",
    "agentNeedsInput":  "review",
    "agentCompleted":   { "play": "jumping", "then": "waiting" },
    "agentTurnFinished":{ "play": "waving",  "then": "waiting" }
  },

  "phaseStates": {
    "idle":      "waiting",
    "attention": "review",
    "success":   "waiting"
  },

  "flashOn": ["agentNeedsInput", "agentCompleted"]
}
